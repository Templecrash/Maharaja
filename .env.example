# LaunchFury Analytics (app id: product-maharaja-2)
# Public browser write key for the prod environment. Set in the deployment's
# build environment so the SDK can be initialized at runtime. Leave empty to
# disable analytics for local-only builds.
VITE_LAUNCHFURY_ANALYTICS_WRITE_KEY=
# Canonical LaunchFury ingest host. Leave unset to use https://launchfury.com.
VITE_LAUNCHFURY_ANALYTICS_HOST=https://launchfury.com
